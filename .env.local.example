# Baseline AI Workforce — optional keys
#
# Copy to .env.local. Everything here is optional: the dashboard boots, detects
# your local CLIs and runs Goals, Journal, Kanban, Memory and the Claude Code
# bridge with none of it set. Each key unlocks one specific agent or feature,
# and the page says so when it is missing.

# ── HTTP-backed agents ──────────────────────────────────────────────────────
# GLM / GLM Code (Zhipu, OpenAI-compatible)
# GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# GLM_MODEL=glm-4.6

# OmniRoute (OpenRouter — any model, one box)
# OPENROUTER_API_KEY=
# OMNIROUTE_MODEL=anthropic/claude-sonnet-4.5

# Hy3 Coder (any OpenAI-compatible coding endpoint you run)
# HY3_API_KEY=
# HY3_BASE_URL=
# HY3_MODEL=

# Sakana
# SAKANA_API_KEY=

# ── Free Claude Code (local model proxy) ────────────────────────────────────
# Start `fcc-server` first; these point the Claude CLI at it instead of Anthropic.
# FCC_BASE_URL=http://127.0.0.1:8082
# FCC_AUTH_TOKEN=fcc-local

# ── Render integrations ─────────────────────────────────────────────────────
# Each one adds a finishing step to a studio. The studio itself always works:
# the brief, script, lyrics, cut list, SVG thumbnail and scoring are local.

# HeyGen — Video Studio → Render tab. Turns a script into finished footage with
# avatar and voice pickers pulled from your account. Test renders are
# watermarked and cost no credits; the switch is on by default.
# HEYGEN_API_KEY=
# HEYGEN_BASE_URL=https://api.heygen.com

# Suno — Music Studio → Render tab. Generation is a task the app polls, then
# downloads; the provider deletes its own copy after about 15 days.
# SUNO_API_KEY=
# SUNO_BASE_URL=https://api.sunoapi.org
# SUNO_MODEL=V4_5

# Image model — Thumbnails → Render tab. Speaks the OpenAI images shape, so any
# compatible endpoint works by changing the base URL.
# IMAGE_API_KEY=            # falls back to OPENAI_API_KEY
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1

# Apollo — Leads → Enrich tab. Personal email and phone reveals cost credits and
# are opt-in per request; nothing is revealed unless you tick the box.
# APOLLO_API_KEY=

# NotebookLM — Notebook → NotebookLM tab, over MCP. Install the CLI, sign in
# once, and the app discovers its tools at runtime.
#   uv tool install notebooklm-mcp && notebooklm-mcp auth
# NOTEBOOKLM_MCP_BIN=       # only if it is not on PATH
# NOTEBOOKLM_MCP_ARGS=

# Realtime voice — the Voice tab on every agent page. Without this the tab falls
# back to push-to-talk using the browser's own recognition and speech synthesis.
# OPENAI_API_KEY=
# REALTIME_MODEL=gpt-realtime
# REALTIME_VOICE=alloy

# ── Hermes ──────────────────────────────────────────────────────────────────
# Where the pantheon, sessions and memories live. The Hermes CLI reads the same
# variable, so one setting unifies both.
# HERMES_HOME=~/.hermes

# ── Paths and behaviour (usually set in Settings instead) ───────────────────
# WORKFORCE_HOME=~/.baseline-workforce
# WORKFORCE_VAULT=/path/to/your/obsidian/vault
# WORKFORCE_CLAUDE_MODEL=claude-opus-4-8
# WORKFORCE_USER_NAME=Walt
# WORKFORCE_CLAUDE_BIN=/opt/homebrew/bin/claude
